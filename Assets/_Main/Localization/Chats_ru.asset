  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Chats_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 75e8584c563754b76a8204d40388f5f9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2360976859136
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438
      \u2014 \u0443\u0436\u0430\u0441\u043D\u044B\u0435 \u043A\u043E\u043C\u0438\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2432942727168
    m_Localized: "\u0418\u0418 \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u043C\u0438\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 2435463503872
    m_Localized: "\u041D\u0443\u0436\u043D\u044B \u043B\u0438 \u0434\u0438\u043F\u043B\u043E\u043C\u044B
      \u043E \u0432\u044B\u0441\u0448\u0435\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2437896200192
    m_Localized: "\u041C\u043E\u0436\u0435\u043C \u043B\u0438 \u043C\u044B \u0441\u043F\u0430\u0441\u0442\u0438
      \u0417\u0435\u043C\u043B\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2440077238272
    m_Localized: "\u0424\u0443\u0442\u0431\u043E\u043B \u043F\u0440\u0430\u0432\u0434\u0430
      \u0442\u0430\u043A\u043E\u0439 \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2440748326912
    m_Localized: "\u0410\u043D\u0430\u043D\u0430\u0441 \u043D\u0430 \u043F\u0438\u0446\u0446\u0435
      \u2014 \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2441419415552
    m_Localized: "\u0427\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0432
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u043C \u0431\u0440\u0430\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2441922732032
    m_Localized: "\u0423\u0437\u043A\u0438\u0435 \u0434\u0436\u0438\u043D\u0441\u044B
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432 \u043C\u043E\u0434\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 2442509934592
    m_Localized: "\u0427\u0442\u043E \u0441\u0430\u043C\u043E\u0435 \u0442\u0440\u0443\u0434\u043D\u043E\u0435
      \u0432 \u0432\u043E\u0441\u043F\u0438\u0442\u0430\u043D\u0438\u0438 \u0434\u0435\u0442\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 2443097137152
    m_Localized: "\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F
      \u043F\u0435\u0440\u0435\u043E\u0446\u0435\u043D\u0435\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 2593764925440
    m_Localized: "\u041E\u043D\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u043D\u0430\u0439\u0442\u0438 \u0441\u043E\u043B\u044C \u0448\u0443\u0442\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2594515705856
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u043E\u043D\u0438
      \u043D\u0430\u0443\u0447\u0430\u0442\u0441\u044F \u0432\u0430\u0440\u0438\u0442\u044C
      \u043A\u043E\u0444\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2595270680576
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0448\u044C
      \u0432\u044B\u0436\u0438\u0442\u044C \u043D\u0430 \u043B\u0430\u043F\u0448\u0435
      \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2595945963520
    m_Localized: "\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E! \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0435 \u0442\u0440\u0443\u0431\u043E\u0447\u043A\u0438
      \u0438 \u043D\u0430\u0447\u043D\u0438\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043C\u043D\u043E\u0433\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0435...
      \u0438\u0437 \u0440\u043E\u0433\u043E\u0432 \u0435\u0434\u0438\u043D\u043E\u0440\u043E\u0433\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2596617052160
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0451\u0442 \u0442\u0440\u0430\u0432\u0430
      \u0432 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u043E\u0439 \u0441\u044A\u0451\u043C\u043A\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 2597288140800
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0442\u044B
      \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u0437\u0430\u043F\u0443\u0442\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0432\u043A\u0443\u0441\u043E\u0432\u044B\u0435 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0440\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2597875343360
    m_Localized: "\u041E\u0441\u0432\u043E\u0438\u0442\u044C \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C: \"\u0422\u044B \u043F\u0440\u0430\u0432\u0430,
      \u0434\u043E\u0440\u043E\u0433\u0430\u044F\"!"
    m_Metadata:
      m_Items: []
  - m_Id: 2598546432000
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u0435\u0431\u044F \u043D\u0430\u0431\u0438\u0442\u043E\u0439 \u0441\u043E\u0441\u0438\u0441\u043A\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 2599217520640
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u0435\u0440\u0435\u0434
      \u0441\u043D\u043E\u043C, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043B \u0431\u044B \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2599804723200
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u0442\u0432\u043E\u0439 \u0447\u0435\u043C\u043E\u0434\u0430\u043D \u0432\u0435\u0441\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u043C\u0430\u0448\u0438\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2600387731456
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044D\u0442\u043E
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0438\u0445 \u0432 \u043F\u043E\u0434\u0432\u0435\u0448\u0435\u043D\u043D\u043E\u043C
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2606851153920
    m_Localized: "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0442\u0435\u0441\u044C!
      \u0418\u043C \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0443\u0436\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u0443\u0447\u0438\u043B\u0438
      \u0438\u0445 \u0441\u0430\u0440\u043A\u0430\u0437\u043C\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 2607522242560
    m_Localized: "\u0414\u0430, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u044C
      \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0442\u0430 \u0441\u0432\u043E\u0438\u043C\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2608193331200
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0431\u0435\u0434\u0438\u0442\u0435 \u0435\u043D\u043E\u0442\u043E\u0432
      \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0439 \u043C\u0443\u0441\u043E\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 2608864419840
    m_Localized: "\u0414\u0430, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0438\u0433\u0440\u043E\u043A\u0438 \u043F\u0430\u0434\u0430\u044E\u0442,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0432 \u043D\u0438\u0445
      \u043F\u043E\u043F\u0430\u043B \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2609535508480
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u044D\u0442\u043E
      \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0442\u043F\u0443\u0441\u043A
      \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E \u0440\u0442\u0430
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C
      \u0441\u043E\u043B\u043D\u0446\u0435\u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439
      \u043A\u0440\u0435\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2610206597120
    m_Localized: "\u041A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441 \u2014
      \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430
      Netflix, \u0431\u0435\u0437 \u0442\u0440\u0451\u0445\u0447\u0430\u0441\u043E\u0432\u044B\u0445
      \u0434\u0435\u0431\u0430\u0442\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 2610961571840
    m_Localized: "\u0414\u0430, \u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0435\u0441\u043B\u0438 \u0442\u044B \u0435\u0449\u0451 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0434\u044B\u0448\u0430\u0442\u044C \u0438 \u0441\u0430\u0434\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2612303749120
    m_Localized: "\u0422\u0430\u0439\u043A\u043E\u043C \u0435\u0441\u0442\u044C \u0432\u043A\u0443\u0441\u043D\u044F\u0448\u043A\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0434\u0435\u0442\u0438 \u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0438
      \u2014 \u044D\u0442\u043E \u043A\u0430\u043A \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0430\u044F
      \u043C\u0438\u0441\u0441\u0438\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 2613310382080
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043A\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u2014 \u044D\u0442\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0434\u043E\u043C\u043E\u0439 \u0432 \u0441\u0432\u043E\u044E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u043A\u0440\u043E\u0432\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
