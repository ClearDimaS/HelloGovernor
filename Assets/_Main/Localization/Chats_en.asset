  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Chats_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 75e8584c563754b76a8204d40388f5f9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2360976859136
    m_Localized: Why do politicians make terrible comedians?
    m_Metadata:
      m_Items: []
  - m_Id: 2432942727168
    m_Localized: Is AI taking over?
    m_Metadata:
      m_Items: []
  - m_Id: 2435463503872
    m_Localized: Are college degrees essential?
    m_Metadata:
      m_Items: []
  - m_Id: 2437896200192
    m_Localized: Can we save the Earth?
    m_Metadata:
      m_Items: []
  - m_Id: 2440077238272
    m_Localized: Is soccer really exciting?
    m_Metadata:
      m_Items: []
  - m_Id: 2440748326912
    m_Localized: Is pineapple on pizza okay?
    m_Metadata:
      m_Items: []
  - m_Id: 2441419415552
    m_Localized: What's key to a happy marriage?
    m_Metadata:
      m_Items: []
  - m_Id: 2441922732032
    m_Localized: Are skinny jeans still cool?
    m_Metadata:
      m_Items: []
  - m_Id: 2442509934592
    m_Localized: What's toughest about parenting?
    m_Metadata:
      m_Items: []
  - m_Id: 2443097137152
    m_Localized: Is traveling overrated?
    m_Metadata:
      m_Items: []
  - m_Id: 2593764925440
    m_Localized: They can't find the punchline!
    m_Metadata:
      m_Items: []
  - m_Id: 2594515705856
    m_Localized: Only if they can figure out how to make coffee!
    m_Metadata:
      m_Items: []
  - m_Id: 2595270680576
    m_Localized: Only if you want to prove you can survive ramen noodles!
    m_Metadata:
      m_Items: []
  - m_Id: 2595945963520
    m_Localized: Absolutely! Just stop using plastic straws and start using reusable
      ones... made of unicorn horns!
    m_Metadata:
      m_Items: []
  - m_Id: 2596617052160
    m_Localized: Only if you enjoy watching grass grow in fast motion!
    m_Metadata:
      m_Items: []
  - m_Id: 2597288140800
    m_Localized: Only if you're trying to confuse your taste buds!
    m_Metadata:
      m_Items: []
  - m_Id: 2597875343360
    m_Localized: Mastering the art of saying "You're right, dear"!
    m_Metadata:
      m_Items: []
  - m_Id: 2598546432000
    m_Localized: Only if you enjoy feeling like a stuffed sausage!
    m_Metadata:
      m_Items: []
  - m_Id: 2599217520640
    m_Localized: Bedtime negotiations that would make a diplomat weep!
    m_Metadata:
      m_Items: []
  - m_Id: 2599804723200
    m_Localized: Only when you realize your suitcase weighs more than a small car!
    m_Metadata:
      m_Items: []
  - m_Id: 2600387731456
    m_Localized: Because it always leaves them hanging!
    m_Metadata:
      m_Items: []
  - m_Id: 2606851153920
    m_Localized: Don't worry! They still need us to teach them sarcasm!
    m_Metadata:
      m_Items: []
  - m_Id: 2607522242560
    m_Localized: Yes, especially if you want to impress your cat with your knowledge!
    m_Metadata:
      m_Items: []
  - m_Id: 2608193331200
    m_Localized: Sure, just convince raccoons to recycle their trash!
    m_Metadata:
      m_Items: []
  - m_Id: 2608864419840
    m_Localized: Yes, especially when the players fall like they've been hit by a
      meteor!
    m_Metadata:
      m_Items: []
  - m_Id: 2609535508480
    m_Localized: "Sure, it's a tropical vacation for your mouth\u2014just don't forget
      the sunscreen!"
    m_Metadata:
      m_Items: []
  - m_Id: 2610206597120
    m_Localized: "Compromise\u2014like agreeing on what to watch on Netflix without
      a three-hour debate!"
    m_Metadata:
      m_Items: []
  - m_Id: 2610961571840
    m_Localized: Yes, but only if you can still breathe and sit down!
    m_Metadata:
      m_Items: []
  - m_Id: 2612303749120
    m_Localized: "Sneaking snacks without the kids finding out\u2014it's like a covert
      mission!"
    m_Metadata:
      m_Items: []
  - m_Id: 2613310382080
    m_Localized: Sure, especially when the best part is coming home to your own bed!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
